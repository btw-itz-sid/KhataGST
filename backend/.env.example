# ─────────────────────────────────────────────────────────────────────────────
# backend/.env.example — KhataGST Backend Environment Variables
# Copy this to backend/.env and fill in real values
# NEVER push .env to git — .gitignore mein listed hai
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Neon PostgreSQL) ────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ── JWT ───────────────────────────────────────────────────────────────────────
# Strong random secret banao: openssl rand -hex 32
JWT_SECRET=change-this-to-a-strong-random-64-char-secret

# ── Google Gemini API (AI bill scan ke liye) ─────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ── Fast2SMS (OTP delivery in production) ────────────────────────────────────
FAST2SMS_API_KEY=your-fast2sms-api-key-here

# ── Razorpay (payments) ─────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your_key_here
RAZORPAY_SECRET=your-razorpay-secret-here
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret-here

# ── Sentry (error tracking — optional) ───────────────────────────────────────
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# ── Cloud Storage (optional — falls back to local disk) ──────────────────────
# Cloudflare R2:
# R2_ACCOUNT_ID=your-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key
# R2_SECRET_ACCESS_KEY=your-r2-secret-key
# R2_BUCKET=khatagst-uploads
# R2_PUBLIC_URL=https://cdn.khatagst.com

# AWS S3:
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION=ap-south-1
# S3_BUCKET=khatagst-uploads
# S3_PUBLIC_URL=https://khatagst-uploads.s3.ap-south-1.amazonaws.com

# ── App Config ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Frontend URL (CORS ke liye — production mein set karo)
FRONTEND_URL=https://app.khatagst.com

# ── File Uploads ──────────────────────────────────────────────────────────────
# UPLOADS_DIR=/mnt/volume/uploads

# ── OTP (Dev Mode) ───────────────────────────────────────────────────────────
DEV_OTP_LOG_PATH=dev-otp.log

# ── Email (optional) ─────────────────────────────────────────────────────────
EMAIL_PROVIDER=development
EMAIL_FROM=no-reply@khatagst.com
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_SECURE=false
ADMIN_EMAILS=admin@khatagst.com
