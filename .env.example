# ─────────────────────────────────────────────────────────────────────────────
# .env.example — KhataGST Backend Environment Variables
# Isko copy karke .env banao, phir apni real values daalo
# NEVER .env ko git mein push karo — .gitignore mein already listed hai
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Neon PostgreSQL) ────────────────────────────────────────────────
# Neon dashboard se copy karo: Settings > Connection Details > Connection string
DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ── JWT ───────────────────────────────────────────────────────────────────────
# Strong random secret banao: openssl rand -hex 32
JWT_SECRET=change-this-to-a-strong-random-64-char-secret

# ── Google Gemini API (AI bill scan ke liye) ─────────────────────────────────
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: specific Gemini model (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# ── Fast2SMS (OTP delivery in production) ────────────────────────────────────
# https://www.fast2sms.com/ > Developer > API
FAST2SMS_API_KEY=your-fast2sms-api-key-here

# ── Razorpay (payment, future use) ───────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your_key_here
RAZORPAY_SECRET=your-razorpay-secret-here

# ── App Config ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Frontend URL (CORS ke liye — production mein set karo)
# Example: https://khatagst.vercel.app
FRONTEND_URL=https://app.khatagst.com

# ── File Uploads ──────────────────────────────────────────────────────────────
# Bill scan images kahan save hon (Railway volume ya local path)
# Default: ./uploads (project root ke andar)
# UPLOADS_DIR=/mnt/volume/uploads

# ── OTP (Dev Mode) ───────────────────────────────────────────────────────────
# Development mein OTP file mein log hota hai — production mein Fast2SMS use hota hai
DEV_OTP_LOG_PATH=dev-otp.log

# ── Email (optional, notifications ke liye) ──────────────────────────────────
# EMAIL_PROVIDER=gmail  # ya: smtp, dev
# GMAIL_USER=your-email@gmail.com
# GMAIL_APP_PASSWORD=your-gmail-app-password
# ADMIN_EMAILS=admin@khatagst.com
